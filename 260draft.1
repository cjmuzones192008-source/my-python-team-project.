import os
import json
import shutil
from datetime import datetime
from decimal import Decimal, InvalidOperation

# ---------------------------------------------------
# Global Constants
# ---------------------------------------------------
DATA_FILE = "expenses.json"
MAX_AMOUNT = Decimal("9999999.99")
MAX_DESCRIPTION = 100
CENTS = Decimal("0.01")
CATEGORIES = [
    "Food",
    "Transportation",
    "Books & Supplies",
    "Rent & Utilities",
    "Entertainment",
    "Miscellaneous"
]

# ---------------------------------------------------
# Validation and input functions
# ---------------------------------------------------
def is_valid_date(text):
    """Return True if text is a real date written as YYYY-MM-DD."""
    if len(text) != 10:
        return False
    try:
        datetime.strptime(text, "%Y-%m-%d")
        return True
    except ValueError:
        return False


def check_amount(amount):
    """Return an error message if the Decimal is not a valid amount, else None."""
    if not amount.is_finite():
        return "Enter a real number such as 150 or 150.75."
    if amount <= 0:
        return "The amount must be greater than zero."
    if amount > MAX_AMOUNT:
        return "The amount is too large."
    if amount != amount.quantize(CENTS):
        return "Use at most 2 decimal places."
    return None


def get_amount(prompt):
    """Keep asking until a valid positive amount is typed.
    Returns a Decimal, or None if the user types 'cancel'."""
    while True:
        text = input(prompt).strip()
        if text.lower() == "cancel":
            return None
        try:
            amount = Decimal(text)
        except InvalidOperation:
            print("  Invalid amount: enter a number such as 150 or 150.75.")
            continue
        error = check_amount(amount)
        if error is not None:
            print("  Invalid amount: " + error)
        else:
            return amount.quantize(CENTS)


def get_description():
    """Keep asking until a non-empty description is typed (None = cancel)."""
    while True:
        text = input("Description: ").strip()
        if text.lower() == "cancel":
            return None
        if text == "":
            print("  Invalid description: it cannot be empty.")
        elif len(text) > MAX_DESCRIPTION:
            print(f"  Invalid description: use at most {MAX_DESCRIPTION} characters.")
        else:
            return text


def get_category(prompt):
    """Show the categories and return the chosen name (None = cancel)."""
    print(prompt)
    for number in range(len(CATEGORIES)):
        print(f"  {number + 1}. {CATEGORIES[number]}")
    while True:
        text = input("Enter 1-6 (or 'cancel'): ").strip()
        if text.lower() == "cancel":
            return None
        try:
            number = int(text)
        except ValueError:
            print("  Invalid choice: please enter a category number.")
            continue
        if 1 <= number <= len(CATEGORIES):
            return CATEGORIES[number - 1]
        print("  Invalid choice: the number must be 1 to 6.")


def get_date():
    """Keep asking until a valid YYYY-MM-DD date is typed (None = cancel)."""
    while True:
        text = input("Date (YYYY-MM-DD, e.g. 2026-10-21): ").strip()
        if text.lower() == "cancel":
            return None
        if is_valid_date(text):
            return text
        print("  Invalid date: use the format YYYY-MM-DD with a real date.")


def ask_yes_no(question):
    """Keep asking until the user answers yes or no. Returns True or False."""
    while True:
        answer = input(question + " (y/n): ").strip().lower()
        if answer == "y" or answer == "yes":
            return True
        if answer == "n" or answer == "no":
            return False
        print("Please answer with 'y' for yes or 'n' for no.")


# ---------------------------------------------------
# Calculation functions (totals are always taken from the list)
# ---------------------------------------------------
def calculate_total(expenses):
    total = Decimal("0.00")
    for expense in expenses:
        total = total + expense["amount"]
    return total


def get_status(total, budget):
    if budget is None:
        return "Budget Not Set"
    if total < budget:
        return "Within Budget"
    if total == budget:
        return "Budget Fully Used"
    return "Over Budget"


def new_id(expenses):
    """Return an ID one higher than the highest ID in use (never a duplicate)."""
    highest = 0
    for expense in expenses:
        if expense["id"] > highest:
            highest = expense["id"]
    return highest + 1


def find_expense(expenses, expense_id):
    for expense in expenses:
        if expense["id"] == expense_id:
            return expense
    return None


# ---------------------------------------------------
# Display functions
# ---------------------------------------------------
def show_menu():
    print("\n" + "=" * 60)
    print("STUDENT EXPENSE TRACKER".center(60))
    print("=" * 60)
    print("1. Set or Update Budget")
    print("2. Add Expense")
    print("3. View All Expenses")
    print("4. View Expense Summary")
    print("5. View Expenses by Category")
    print("6. Delete an Expense")
    print("7. Save and Exit")


def show_title(title):
    print("\n" + "=" * 60)
    print(title.center(60))
    print("=" * 60)


def show_table(expenses):
    print(f"{'ID':<5}{'Date':<12}{'Description':<27}{'Category':<17}{'Amount':>14}")
    print("-" * 75)
    for expense in expenses:
        print(f"{expense['id']:<5}{expense['date']:<12}"
              f"{expense['description']:<27}{expense['category']:<17}"
              f"{expense['amount']:>14,.2f}")
    print("-" * 75)


def show_expense(expense):
    print(f"  ID          : {expense['id']}")
    print(f"  Date        : {expense['date']}")
    print(f"  Description : {expense['description']}")
    print(f"  Category    : {expense['category']}")
    print(f"  Amount      : PHP {expense['amount']:,.2f}")


def show_balance(budget, expenses):
    """Show total, remaining balance, and status (used after every change)."""
    total = calculate_total(expenses)
    status = get_status(total, budget)
    print(f"Total expenses    : PHP {total:,.2f}")
    if budget is None:
        print("Remaining balance : N/A (no budget has been set)")
    else:
        print(f"Remaining balance : PHP {budget - total:,.2f}")
    print(f"Budget status     : {status}")
    if status == "Over Budget":
        print(f"WARNING: You are over your budget by PHP {total - budget:,.2f}!")
    elif status == "Budget Fully Used":
        print("NOTICE: You have used your entire budget.")


# ---------------------------------------------------
# Main features
# ---------------------------------------------------
def set_budget(budget, expenses):
    """Set or update the budget. Returns the (new) budget."""
    show_title("SET OR UPDATE BUDGET")
    if budget is None:
        print("No budget is set yet.")
    else:
        print(f"Current budget: PHP {budget:,.2f}")

    new_budget = get_amount("Enter the budget amount (or 'cancel'): ")
    if new_budget is None:
        print("Cancelled. The budget was not changed.")
        return budget

    if budget is None:
        print(f"\nBudget set to PHP {new_budget:,.2f}.")
    else:
        print(f"\nBudget updated from PHP {budget:,.2f} to PHP {new_budget:,.2f}.")
    print(f"Your {len(expenses)} existing expense record(s) were kept.")
    show_balance(new_budget, expenses)
    return new_budget


def add_expense(budget, expenses):
    """Ask for the four details, then add the expense to the list."""
    show_title("ADD EXPENSE")
    print("(Type 'cancel' at any prompt to cancel this entry.)")

    description = get_description()
    if description is None:
        print("Entry cancelled. Nothing was saved.")
        return
    category = get_category("Choose a category:")
    if category is None:
        print("Entry cancelled. Nothing was saved.")
        return
    amount = get_amount("Amount: ")
    if amount is None:
        print("Entry cancelled. Nothing was saved.")
        return
    expense_date = get_date()
    if expense_date is None:
        print("Entry cancelled. Nothing was saved.")
        return

    # All four details are valid, so the expense can be added.
    expense = {"id": new_id(expenses), "date": expense_date,
               "description": description, "category": category,
               "amount": amount}
    expenses.append(expense)
    print("\nExpense added successfully!")
    show_expense(expense)
    print()
    show_balance(budget, expenses)


def view_expenses(expenses):
    show_title("ALL EXPENSES")
    if len(expenses) == 0:
        print("No expenses have been recorded yet. Use option 2 to add one.")
        return
    show_table(expenses)
    print(f"Number of expenses: {len(expenses)}")
    print(f"Total expenses    : PHP {calculate_total(expenses):,.2f}")


def view_summary(budget, expenses):
    show_title("EXPENSE SUMMARY")
    total = calculate_total(expenses)

    if budget is None:
        print("Total budget       : Not set")
        print(f"Total expenses     : PHP {total:,.2f}")
        print("Remaining balance  : N/A (no budget has been set)")
    else:
        print(f"Total budget       : PHP {budget:,.2f}")
        print(f"Total expenses     : PHP {total:,.2f}")
        print(f"Remaining balance  : PHP {budget - total:,.2f}")
    print(f"Number of expenses : {len(expenses)}")

    if len(expenses) == 0:
        print("Highest expense    : N/A (no expenses recorded)")
        print("Lowest expense     : N/A (no expenses recorded)")
    else:
        highest = expenses[0]
        lowest = expenses[0]
        for expense in expenses:
            if expense["amount"] > highest["amount"]:
                highest = expense
            if expense["amount"] < lowest["amount"]:
                lowest = expense
        print(f"Highest expense    : PHP {highest['amount']:,.2f} "
              f"({highest['description']}, ID {highest['id']})")
        print(f"Lowest expense     : PHP {lowest['amount']:,.2f} "
              f"({lowest['description']}, ID {lowest['id']})")

    if budget is None:
        print("Budget utilization : N/A (no budget has been set)")
    else:
        percent = (total / budget * 100).quantize(CENTS)
        print(f"Budget utilization : {percent}%")
    status = get_status(total, budget)
    print(f"Budget status      : {status}")
    if status == "Over Budget":
        print(f"WARNING: You are over your budget by PHP {total - budget:,.2f}!")
    elif status == "Budget Fully Used":
        print("NOTICE: You have used your entire budget.")

    print("\nSpending by category:")
    for category in CATEGORIES:
        category_total = Decimal("0.00")
        count = 0
        for expense in expenses:
            if expense["category"] == category:
                category_total = category_total + expense["amount"]
                count = count + 1
        print(f"  {category:<16}{category_total:>16,.2f}   ({count} expense(s))")


def view_by_category(expenses):
    show_title("VIEW EXPENSES BY CATEGORY")
    category = get_category("Choose a category to view:")
    if category is None:
        print("Cancelled.")
        return

    matches = []
    for expense in expenses:
        if expense["category"] == category:
            matches.append(expense)

    print(f"\nCategory: {category}")
    if len(matches) == 0:
        print("No expenses were found in this category.")
        return
    show_table(matches)
    print(f"Number of expenses in {category}: {len(matches)}")
    print(f"Total spent in {category}: PHP {calculate_total(matches):,.2f}")


def delete_expense(budget, expenses):
    show_title("DELETE AN EXPENSE")
    if len(expenses) == 0:
        print("There are no expenses to delete.")
        return
    show_table(expenses)


    while True:
        text = input("Enter the ID to delete (or 'cancel'): ").strip()
        if text.lower() == "cancel":
            print("Cancelled. No expense was deleted.")
            return
        if not (text.isascii() and text.isdigit()):
            print("  Invalid ID: please enter a whole number from the table.")
            continue
        expense = find_expense(expenses, int(text))
        if expense is None:
            print(f"  No expense with ID {int(text)} exists.")
            continue
        break

    print("\nYou chose this expense:")
    show_expense(expense)
    if not ask_yes_no("Are you sure you want to delete it?"):
        print("Cancelled. No expense was deleted.")
        return

    expenses.remove(expense)
    print(f"\nExpense {expense['id']} was deleted. Updated totals:")
    show_balance(budget, expenses)


# ---------------------------------------------------
# File handling
# ---------------------------------------------------
def check_record(record, used_ids):
    """Check one saved record. Returns a clean expense dictionary,
    or raises an error if the record is not valid."""
    expense_id = record["id"]
    if type(expense_id) is not int or expense_id < 1 or expense_id in used_ids:
        raise ValueError("bad or duplicate ID")
    description = record["description"].strip()
    if description == "":
        raise ValueError("empty description")
    if record["category"] not in CATEGORIES:
        raise ValueError("unknown category")
    if not is_valid_date(record["date"]):
        raise ValueError("invalid date")
    amount = Decimal(record["amount"])
    if check_amount(amount) is not None:
        raise ValueError("invalid amount")
    return {"id": expense_id, "date": record["date"],
            "description": description, "category": record["category"],
            "amount": amount.quantize(CENTS)}


def load_data():
    """Read the JSON file. Returns (budget, expenses, problems).
    'problems' is a list of messages; it is empty when all is well."""
    budget = None
    expenses = []
    if not os.path.exists(DATA_FILE):
        return budget, expenses, []          # first launch

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            saved = json.load(file)
    except OSError as error:
        return budget, expenses, [f"The data file could not be read ({error})."]
    except ValueError:                       # damaged JSON or bad text
        return budget, expenses, ["The data file is not valid JSON (it is damaged)."]

    if not isinstance(saved, dict) or not isinstance(saved.get("expenses"), list):
        return budget, expenses, ["The data file does not have the expected structure."]

    problems = []
    if saved.get("budget") is not None:
        try:
            budget = Decimal(saved["budget"])
            if check_amount(budget) is not None:
                raise ValueError("invalid budget")
            budget = budget.quantize(CENTS)
        except (TypeError, ValueError, InvalidOperation):
            budget = None
            problems.append("The saved budget is invalid; it was reset to 'not set'.")

    used_ids = []
    position = 0
    for record in saved["expenses"]:
        position = position + 1
        try:
            expense = check_record(record, used_ids)
        except (KeyError, TypeError, AttributeError, ValueError, InvalidOperation):
            problems.append(f"Record #{position} was skipped because it is not valid.")
            continue
        expenses.append(expense)
        used_ids.append(expense["id"])
    return budget, expenses, problems


def make_backup():
    """Copy the data file to a backup file. Returns the backup name or None."""
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_name = DATA_FILE + ".backup-" + stamp
    number = 1
    while os.path.exists(backup_name):       # never overwrite an old backup
        number = number + 1
        backup_name = DATA_FILE + ".backup-" + stamp + "-" + str(number)
    try:
        shutil.copy2(DATA_FILE, backup_name)
        return backup_name
    except OSError:
        return None


def save_data(budget, expenses, filename=DATA_FILE):
    """Save to JSON. Returns (True, "") or (False, error message).
    The data is written to a temporary file first, so a failure cannot
    destroy the old file."""
    saved = {"budget": None if budget is None else f"{budget:.2f}",
             "expenses": []}
    for expense in expenses:
        saved["expenses"].append({"id": expense["id"],
                                  "date": expense["date"],
                                  "description": expense["description"],
                                  "category": expense["category"],
                                  "amount": f"{expense['amount']:.2f}"})
    temp_name = filename + ".tmp"
    try:
        with open(temp_name, "w", encoding="utf-8") as file:
            json.dump(saved, file, indent=2)
        os.replace(temp_name, filename)
    except (OSError, TypeError, ValueError) as error:
        try:
            os.remove(temp_name)
        except OSError:
            pass
        return False, str(error)
    return True, ""


def save_and_exit(budget, expenses):
    """Save the data. If saving fails, tell the user and let them choose."""
    while True:
        saved, error = save_data(budget, expenses)
        if saved:
            print(f"\nData saved successfully to:\n  {DATA_FILE}")
            print("Goodbye!")
            return
        print(f"\nERROR: Your data could NOT be saved ({error}).")
        choice = ""
        while choice != "r" and choice != "x":
            choice = input("Type R to retry saving, or X to exit WITHOUT saving: ")
            choice = choice.strip().lower()
        if choice == "x":
            print("Exiting without saving. Changes made in this session are lost.")
            return


# ---------------------------------------------------
# Main program
# ---------------------------------------------------
def main():
    print("Welcome to the Student Expense Tracker!")
    file_existed = os.path.exists(DATA_FILE)
    budget, expenses, problems = load_data()

    if len(problems) > 0:
        print("PROBLEM WITH THE SAVED DATA FILE:")
        for problem in problems:
            print("  - " + problem)
        backup_name = make_backup()
        if backup_name is None:
            print("\nA backup copy could not be made, so the program will close")
            print("to avoid overwriting your saved data. Please check the file.")
            return
        print(f"\nA copy of the original file was kept as:\n  {backup_name}")
        print(f"Continuing with the {len(expenses)} recoverable expense(s).")
    elif file_existed:
        print(f"Saved data loaded: {len(expenses)} expense(s).")
    else:
        print("No saved data file found. Starting fresh (first launch).")

    while True:
        show_menu()
        choice = input("Choose an option (1-7): ").strip()
        if choice == "1":
            budget = set_budget(budget, expenses)
        elif choice == "2":
            add_expense(budget, expenses)
        elif choice == "3":
            view_expenses(expenses)
        elif choice == "4":
            view_summary(budget, expenses)
        elif choice == "5":
            view_by_category(expenses)
        elif choice == "6":
            delete_expense(budget, expenses)
        elif choice == "7":
            save_and_exit(budget, expenses)
            break
        else:
            print(f"\nInvalid choice '{choice}'. Please enter a number from 1 to 7.")


if __name__ == "__main__":
    main()
